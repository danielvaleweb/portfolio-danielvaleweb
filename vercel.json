{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/projeto/:id*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Pinterest|Googlebot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "direct"
        }
      ],
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/avaliar/:id*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Pinterest|Googlebot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "direct"
        }
      ],
      "destination": "/api/preview?id=:id&isEval=1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
