rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projetos globais e coleções separadas por categoria
    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /projetos_imobiliario/{docId} {
      allow read, write: if true;
    }

    match /projetos_publicidade/{docId} {
      allow read, write: if true;
    }

    match /projetos_institucional/{docId} {
      allow read, write: if true;
    }

    // Estrutura hierárquica projetos/{categoria}/itens/{docId}
    match /projetos/{categoria} {
      allow read, write: if true;
      match /itens/{docId} {
        allow read, write: if true;
      }
      match /{allSub=**} {
        allow read, write: if true;
      }
    }

    // Coleções de clientes (português e inglês)
    match /clientes/{clienteId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Notas e anotações
    match /notas/{notaId} {
      allow read, write: if true;
    }

    // Arquivos e anexos de projetos
    match /arquivos/{arquivoId} {
      allow read, write: if true;
    }

    // Conversas e mensagens de chat
    match /conversas/{conversaId} {
      allow read, write: if true;
      match /{allSub=**} {
        allow read, write: if true;
      }
    }

    // Comunicações por e-mail
    match /emails/{emailId} {
      allow read, write: if true;
    }

    // Calendário de gravações e entregas
    match /calendario/{eventoId} {
      allow read, write: if true;
    }

    // Base de conhecimento e tutoriais
    match /base_conhecimento/{artigoId} {
      allow read, write: if true;
    }

    // Mensagens de contato e leads
    match /mensagens/{mensagemId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Avaliações de clientes
    match /evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // Notificações administrativas
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Configurações do sistema
    match /configuracoes/{configId} {
      allow read, write: if true;
    }

    // Permissão ampla para sincronização de coleções
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

